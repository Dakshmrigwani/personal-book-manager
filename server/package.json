{
  "name": "node-express-starter",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:dev": "tsc --noEmit && cross-env NODE_ENV=development tsx watch src/index",
    "start:pm2": "pm2 start ecosystem.config.json --no-daemon",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "lint": "biome lint ",
    "lint:fix": "biome lint --write",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:cov": "vitest run --coverage",
    "add:env": "tsx ./scripts/add-env.ts",
    "seed:admin": "tsx ./scripts/seed-admin.ts",
    "prepare": "husky",
    "generate": "plop"
  },
  "keywords": [],
  "author": "hassandev404@gmail.com",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "4.x",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.14.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "pm2": "^6.0.5",
    "validator": "^13.15.0",
    "winston": "^3.17.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@faker-js/faker": "^10.2.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@types/validator": "^13.15.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "4.0.16",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "mongodb-memory-server": "^11.0.1",
    "plop": "^4.0.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
